# Copy to .env (scripts/up.sh does this and generates fresh random secrets). Demo only: no real cloud credentials.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
CQ_DB_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_HMAC_SECRET=change-me        # signs API->n8n events and n8n->API callbacks
RUNNER_HMAC_SECRET=change-me     # signs API->Custodian runner requests
N8N_API_TOKEN=change-me          # bearer token of the n8n automation principal
CQ_RUNNER_TOKEN=change-me
RUN_NOW_SECRET=change-me         # header secret for the manual "run analysis now" webhook
# CloudQuery plugin pins (docs/PHASE0.md). aws downloads anonymously; the postgresql destination is built from source.
CQ_AWS_VERSION=v22.19.2
CQ_PG_VERSION=v8.17.0-source-build
# Optional: a free CloudQuery API key is NOT needed with the pins above.
CLOUDQUERY_API_KEY=
APPROVAL_TTL_SECONDS=1800
SNAPSHOT_MAX_AGE_SECONDS=3600
SEED_TODAY=
