# Copy to .env (scripts/up.sh does this and generates fresh random secrets). Demo only: no real cloud credentials.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
CQ_DB_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_HMAC_SECRET=change-me        # signs API->n8n events and n8n->API callbacks
RUNNER_HMAC_SECRET=change-me     # signs API->Custodian runner requests
N8N_API_TOKEN=change-me          # bearer token of the n8n automation principal
CQ_RUNNER_TOKEN=change-me
RUN_NOW_SECRET=change-me         # header secret for the manual "run analysis now" webhook
# CloudQuery plugin pins (docs/PHASE0.md). aws downloads anonymously; the postgresql destination is built from source.
CQ_AWS_VERSION=v22.19.2
CQ_PG_VERSION=v8.17.0-source-build
# Optional: a free CloudQuery API key is NOT needed with the pins above.
CLOUDQUERY_API_KEY=
APPROVAL_TTL_SECONDS=1800
SNAPSHOT_MAX_AGE_SECONDS=3600
SEED_TODAY=

# Optional Slack notifications from n8n. Create an Incoming Webhook in Slack (api.slack.com/messaging/webhooks) and paste the URL here.
# Leave empty to disable. Treat it like a password; do not commit .env.
SLACK_WEBHOOK_URL=
POSTGRES_HOST_PORT=5433
LOCALSTACK_HOST_PORT=4566
API_HOST_PORT=8000
N8N_HOST_PORT=5678
DASHBOARD_HOST_PORT=3000

# Optional LLM that ONLY rewrites verified evidence into a readable Slack investigation note (it never computes money,
# picks owners, approves or executes; its output is rejected unless every number/id/owner appears in the evidence).
# Empty = deterministic template summaries. When enabled, the evidence packet (workload, tenant, resource ids, owner,
# projected saving) is sent to the provider; it contains no PINs, hashes, policy text or tokens.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# alert_only (default): the system investigates and alerts, humans decide and fix; an approval is only recorded.
# tag_after_approval: after a named human approves, the isolated runner may apply ONE reversible tag (needed for the full executed/verified demo).
ACTION_MODE=alert_only
