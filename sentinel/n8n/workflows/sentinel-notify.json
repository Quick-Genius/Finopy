      "id": "sentinelNotify00001-16",
      "name": "Outcome: Check Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        -20
      ],
      "parameters": {
        "jsCode": "\n// Slack incoming webhooks answer 200 \"ok\". Temporary trouble (429/5xx/network) is retried; a 4xx is permanent\n// (bad URL / revoked webhook): it is surfaced in the execution but never retried forever.\nconst r = $input.first().json; const c = Number(r.statusCode || 0);\nif (c === 0 || c === 429 || c >= 500) throw new Error('Slack temporary failure HTTP ' + c);\nreturn [{ json: { slack_status: c, slack_ok: c === 200, slack_error: c === 200 ? null : String(r.body || '').slice(0, 120) } }];\n"
      },
      "onError": "continueErrorOutput"
    }
