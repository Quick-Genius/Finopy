        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('dedupe lookup answered HTTP ' + r.statusCode);\nreturn [{ json: { duplicate: !!(r.body && r.body.seen) } }];\n"
