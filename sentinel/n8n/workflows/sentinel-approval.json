      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-10",
      "name": "Check published",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        40
      ],
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('form-url publish answered HTTP ' + r.statusCode);\nreturn [{ json: { published: true } }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-11",
      "name": "Seen before?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        -140
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SENTINEL_API }}/internal/events/{{ encodeURIComponent($json.event.event_id) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-12",
      "name": "Check seen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        -140
      ],
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('dedupe lookup answered HTTP ' + r.statusCode);\nreturn [{ json: { duplicate: !!(r.body && r.body.seen) } }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-13",
      "name": "Mark seen (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        40
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.SENTINEL_API }}/internal/events/{{ encodeURIComponent($node['Verify signature'].json.event.event_id) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'approval' }) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-14",
      "name": "Mark handled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1750,
        40
      ],
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('marking the event seen answered HTTP ' + r.statusCode);\nreturn [{ json: { handled: true } }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-15",
      "name": "Respond accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1800,
        40
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "sentinelApproval001-16",
      "name": "Build form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        40
      ],
      "parameters": {
        "jsCode": "\n// Everything shown comes from the API's own record of the approval; values are HTML-escaped.\nconst p = $('Check packet').first().json;\nconst e = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst err = $json.lastError ? `<p style=\"color:#b3261e\"><b>Previous attempt refused:</b> ${e($json.lastError)}</p>` : '';\nconst rows = [\n  ['Tenant', p.tenant_id], ['Accountable owner', `${p.owner} (confidence ${p.attribution_confidence})`], ['Proposed fix', p.action_mode === 'tag_after_approval' ? `${p.action} via template ${p.template} (applied by the isolated runner after you approve)` : `${p.action} via template ${p.template} (NOT applied by the system: approving only records your decision, a person does the fix)`],\n  ['Exact targets (' + p.target_count + ')', p.targets.map((t) => `${t.id}${t.name ? ' (' + t.name + ')' : ''}`).join(', ')],\n  ['Excluded', (p.excluded || []).map((x) => `${x.resource_id}: ${x.reason}`).join('; ') || 'none'],\n  ['Projected saving', `${p.projected_savings.monthly} ${p.projected_savings.currency}/month (projected, not realized)`],\n  ['Assumptions', (p.projected_savings.assumptions || []).join('; ')], ['Risk', p.risk], ['Rollback', p.rollback], ['Why', (p.why || []).join('; ')],\n  ['Policy sha256', p.policy_sha256], ['Target-set sha256', p.target_set_sha256], ['Case / version', `${p.case_id} / v${p.case_version}`], ['Expires (UTC)', p.expires_at],\n];\nconst html = err + '<table style=\"text-align:left;font-size:13px\">' + rows.map(([k, v]) => `<tr><th style=\"padding-right:12px;vertical-align:top\">${e(k)}</th><td style=\"word-break:break-all\">${e(v)}</td></tr>`).join('') + '</table>' +\n  '<p>Your decision is checked by the Sentinel API against its own copy of these values. The form cannot change targets, policy or tenant.</p>';\nreturn [{ json: { formHtml: html, retry: !!$json.lastError } }];\n"
      }
    },
    {
      "id": "sentinelApproval001-17",
      "name": "Build Slack approval message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        40
      ],
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst sm = (() => { try { const b = $('Summarize case').first().json.body; return b && b.summary ? b : null; } catch (e) { return null; } })();\n\n// Sent once per approval (not again after a wrong-PIN retry). The link is the n8n form; the API still checks ID + PIN.\nif ($json.retry) return [{ json: { slack_text: '' } }];\nconst p = $('Check packet').first().json;\nconst ids = p.targets.map((t) => `${esc(t.id)}${t.name ? ' (' + esc(t.name) + ')' : ''}`).join(', ');\nconst lines = [`:bell: *Approval needed* \\u2014 ${esc(p.owner)} \\u00b7 tenant *${esc(p.tenant_id)}*`,\n  `case \\`${esc(p.case_id)}\\` v${esc(p.case_version)} \\u00b7 proposed fix: ${esc(p.action)} \\u00b7 risk: ${esc(p.risk)}`,\n  p.action_mode === 'tag_after_approval' ? '_Alert only: nothing has been changed yet. A human decides; the only action the system can ever take is a reversible tag._' : '_Alert only: nothing has been changed, and the system will not change anything. A human decides and fixes it by hand._', ''];\nif (sm && sm.briefing) lines.push(sm.briefing, '');\nelse lines.push(`projected saving: ${esc(p.projected_savings.monthly)} ${esc(p.projected_savings.currency)}/month (projected, not realized)`, `rollback: ${esc(p.rollback)}`, '');\nlines.push(`*Exact targets (${p.target_count}):* ${ids}`);\nif (p.excluded && p.excluded.length) lines.push('*Excluded:* ' + p.excluded.map((x) => `${esc(x.resource_id)} (${esc(x.reason)})`).join('; '));\nlines.push(`*Expires:* ${esc(p.expires_at)}`,\n  `<${$execution.resumeFormUrl}|Open the approval form> \\u2014 needs approver ID + PIN. Silence expires it; nothing is ever auto-approved.`);\n\nif (sm) lines.push('', '*Investigation summary* (' + (sm.source === 'llm' ? 'AI-written from verified evidence, every number and id fact-checked' : 'built from verified evidence') + '):\\n' + esc(sm.summary));\ntry { lines.push('', '_ref ' + $('Verify signature').first().json.event.event_id + '_'); } catch (e) { /* no reference available */ }\nreturn [{ json: { slack_text: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "sentinelApproval001-18",
      "name": "Wait for approver",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2200,
        40
      ],
      "parameters": {
        "resume": "form",
        "formTitle": "Sentinel approval",
        "formDescription": "={{ $node['Build form'].json.formHtml }}",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Approver ID",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "e.g. payments-approver"
            },
            {
              "fieldLabel": "Approver PIN",
              "fieldType": "password",
              "requiredField": true
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "approve"
                  },
                  {
                    "option": "reject"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Note",
              "fieldType": "textarea"
            }
          ]
        },
        "limitWaitTime": true,
        "limitType": "atSpecifiedTime",
        "maxDateAndTime": "={{ new Date(new Date($node['Check packet'].json.expires_at).getTime() + 3000).toISOString() }}",
        "options": {}
      },
      "webhookId": "sentinel-approval-form"
    },
    {
      "id": "sentinelApproval001-19",
      "name": "Build signed callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        40
      ],
      "parameters": {
        "jsCode": "\n// Signs EXACTLY the bytes that the next node sends. The body carries only identifiers and the values the approver saw.\nconst crypto = require('crypto');\nconst p = $('Check packet').first().json;\nconst f = $input.first().json;\nconst decided = !!f['Decision'];                       // a timed-out wait resumes with no form data\nconst body = {\n  approval_id: p.approval_id, case_id: p.case_id, decision: decided ? f['Decision'] : 'timeout',\n  actor_id: decided ? String(f['Approver ID']).trim() : 'system:n8n-timeout', actor_proof: decided ? String(f['Approver PIN']) : null,\n  case_version: p.case_version, policy_sha256: p.policy_sha256, target_set_sha256: p.target_set_sha256, expires_at: p.expires_at,\n  idempotency_key: [p.approval_id, decided ? f['Decision'] : 'timeout', decided ? String(f['Approver ID']).trim() : 'timeout'].join(':'),\n};\nconst raw = JSON.stringify(body);\nconst ts = String(Math.floor(Date.now() / 1000));\nconst sig = crypto.createHmac('sha256', $env.SENTINEL_HMAC_SECRET).update(ts + '.').update(raw).digest('hex');\nreturn [{ json: { raw, ts, sig, decision: body.decision } }];\n"
      }
    },
    {
      "id": "sentinelApproval001-20",
      "name": "Callback /approve (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2600,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_API }}/approve",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            },
            {
              "name": "x-sentinel-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-sentinel-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw }}"
      }
    },
    {
      "id": "sentinelApproval001-21",
      "name": "Refused (identity)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2800,
        40
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode === 403 && $node['Build signed callback'].json.decision !== 'timeout' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sentinelApproval001-22",
      "name": "Remember refusal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { lastError: String(($input.first().json.body && $input.first().json.body.error) || 'refused') } }];"
      }
    },
    {
      "id": "sentinelApproval001-23",
      "name": "Check result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        120
      ],
      "parameters": {
        "jsCode": "\n// 2xx = recorded; 409 = gate already closed (duplicate click / expired / version changed) - nothing more to do. Anything else is a visible failure.\nconst r = $input.first().json;\nconst code = Number(r.statusCode);\nconst b = r.body && typeof r.body === 'object' ? r.body : {};\nif ((code >= 200 && code < 300) || code === 409) return [{ json: { status_code: code, outcome: String(b.outcome || b.error || '') } }];\nthrow new Error('POST /approve failed with HTTP ' + code + ': ' + JSON.stringify(b).slice(0, 300));\n"
      }
    },
    {
      "id": "sentinelApproval001-24",
      "name": "Summarize case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SENTINEL_API }}/cases/{{ encodeURIComponent($node['Check packet'].json.case_id) }}/summary",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "sentinelApproval001-25",
      "name": "Approval: Slack on?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2150,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ !!$env.SENTINEL_SLACK_WEBHOOK_URL && !!$json.slack_text }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
