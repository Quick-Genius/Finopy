    {
      "id": "sentinelApproval001-7",
      "name": "Get approval packet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        40
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SENTINEL_API }}/approvals/{{ encodeURIComponent($node['Verify signature'].json.event.approval_id) }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-8",
      "name": "Check packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        40
      ],
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('API answered HTTP ' + r.statusCode);\nreturn [{ json: JSON.parse(JSON.stringify(r.body)) }];     // plain copy: returning n8n proxy objects overflows the stack\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "sentinelApproval001-9",
      "name": "Publish form URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_API }}/approvals/{{ encodeURIComponent($json.approval_id) }}/form-url",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
