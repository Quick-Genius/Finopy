{
  "id": "sentinelAnalysis01",
  "name": "Sentinel scheduled analysis",
  "nodes": [
    {
      "id": "sentinelAnalysis01-0",
      "name": "Hourly schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "sentinelAnalysis01-1",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sentinel-run-now",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "sentinel-run-now"
    },
    {
      "id": "sentinelAnalysis01-2",
      "name": "Secret ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.headers['x-run-now-secret'] === $env.SENTINEL_RUN_NOW_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sentinelAnalysis01-3",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ started: true }) }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "sentinelAnalysis01-4",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: \"bad run-now secret\" }) }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "sentinelAnalysis01-5",
      "name": "CloudQuery sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_CQ_URL }}/sync",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_CQ_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "sentinelAnalysis01-6",
      "name": "Build analysis request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "\n// The CloudQuery job returns a completion record; carry its sync_id into the analysis (snapshot lineage).\nconst s = $input.first().json;\nreturn [{ json: { tenant_ids: ['payments', 'analytics'], idempotency_prefix: 'run-' + s.sync_id,\n  sync: { sync_id: s.sync_id, started_at: s.started_at, finished_at: s.finished_at, plugin_versions: s.plugin_versions, exit_code: s.exit_code } } }];\n"
      }
    },
    {
      "id": "sentinelAnalysis01-7",
      "name": "Analyze (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_API }}/internal/analyze",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Hourly schedule": {
      "main": [
        [
          {
            "node": "CloudQuery sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Secret ok?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Secret ok?": {
      "main": [
        [
          {
            "node": "Respond 202",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 202": {
      "main": [
        [
          {
            "node": "CloudQuery sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CloudQuery sync": {
      "main": [
        [
          {
            "node": "Build analysis request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build analysis request": {
      "main": [
        [
          {
            "node": "Analyze (API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "sentinelAnalysis01-v1"
}
