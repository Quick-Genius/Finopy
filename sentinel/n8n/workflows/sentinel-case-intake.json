      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nif (r.statusCode >= 500) throw new Error('dry-run failed with HTTP ' + r.statusCode);\n// 2xx = done; 4xx (e.g. 409 blocked / not eligible) is a definite answer from the API, not something a retry fixes\nreturn [{ json: { dry_run_status: r.statusCode, body: JSON.parse(JSON.stringify(r.body ?? null)) } }];\n"
      },
      "onError": "continueErrorOutput"
    },
