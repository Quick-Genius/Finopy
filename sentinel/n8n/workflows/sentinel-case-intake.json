                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sentinelIntake0001-8",
      "name": "Start dry-run (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SENTINEL_API }}/cases/{{ $node['Verify signature'].json.event.case_id }}/dry-run",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SENTINEL_N8N_TOKEN }}"
            }
          ]
        },
        "options": {
