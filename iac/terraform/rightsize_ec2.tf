# Terraform template for EC2 instance rightsizing
# This template is generated by the FinOps agent when an instance is approved for downsizing

variable "instance_id" {
  description = "The EC2 instance to resize"
  type        = string
}

variable "target_instance_type" {
  description = "The new (smaller) instance type"
  type        = string
}

variable "region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

provider "aws" {
  region = var.region
}

# Stop the instance, modify, restart
resource "null_resource" "resize_instance" {
  triggers = {
    instance_id   = var.instance_id
    instance_type = var.target_instance_type
  }

  provisioner "local-exec" {
    command = <<-EOT
      aws ec2 stop-instances --instance-ids ${var.instance_id} --region ${var.region}
      aws ec2 wait instance-stopped --instance-ids ${var.instance_id} --region ${var.region}
      aws ec2 modify-instance-attribute --instance-id ${var.instance_id} --instance-type ${var.target_instance_type} --region ${var.region}
      aws ec2 start-instances --instance-ids ${var.instance_id} --region ${var.region}
      aws ec2 wait instance-running --instance-ids ${var.instance_id} --region ${var.region}
    EOT
  }
}

output "result" {
  value = "Instance ${var.instance_id} resized to ${var.target_instance_type}"
}
