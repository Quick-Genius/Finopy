# Terraform template for cleaning up idle resources
# Generated by FinOps agent for approved terminations

variable "resource_ids" {
  description = "List of resource IDs to terminate/delete"
  type        = list(string)
}

variable "resource_type" {
  description = "Type of resource (ec2_instance, ebs_volume, elastic_ip)"
  type        = string
}

variable "region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

provider "aws" {
  region = var.region
}

# Conditionally terminate EC2 instances
resource "null_resource" "terminate_instances" {
  count = var.resource_type == "ec2_instance" ? 1 : 0

  provisioner "local-exec" {
    command = "aws ec2 terminate-instances --instance-ids ${join(" ", var.resource_ids)} --region ${var.region}"
  }
}

# Conditionally delete EBS volumes
resource "null_resource" "delete_volumes" {
  count = var.resource_type == "ebs_volume" ? 1 : 0

  provisioner "local-exec" {
    command = <<-EOT
      %{ for vol_id in var.resource_ids ~}
      aws ec2 delete-volume --volume-id ${vol_id} --region ${var.region}
      %{ endfor ~}
    EOT
  }
}

# Conditionally release Elastic IPs
resource "null_resource" "release_eips" {
  count = var.resource_type == "elastic_ip" ? 1 : 0

  provisioner "local-exec" {
    command = <<-EOT
      %{ for alloc_id in var.resource_ids ~}
      aws ec2 release-address --allocation-id ${alloc_id} --region ${var.region}
      %{ endfor ~}
    EOT
  }
}

output "result" {
  value = "Cleaned up ${length(var.resource_ids)} ${var.resource_type} resources"
}
