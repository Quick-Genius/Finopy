# AWS Credentials
FINOPS_AWS_REGION=us-east-1
FINOPS_AWS_ACCESS_KEY_ID=
FINOPS_AWS_SECRET_ACCESS_KEY=

# GCP (optional)
FINOPS_GCP_PROJECT_ID=
FINOPS_GCP_BILLING_ACCOUNT_ID=

# LLM Provider
FINOPS_LLM_PROVIDER=bedrock
FINOPS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
FINOPS_OPENAI_API_KEY=

# Database
FINOPS_DATABASE_URL=postgresql://finops:finops@localhost:5432/finops
FINOPS_REDIS_URL=redis://localhost:6379/0

# Slack
FINOPS_SLACK_WEBHOOK_URL=
FINOPS_SLACK_APPROVAL_CHANNEL=#finops-approvals

# Email (SMTP)
FINOPS_SMTP_HOST=
FINOPS_SMTP_PORT=587
FINOPS_SMTP_USER=
FINOPS_SMTP_PASSWORD=
FINOPS_EMAIL_FROM=finops@example.com

# Jira (upcoming)
FINOPS_JIRA_URL=
FINOPS_JIRA_API_TOKEN=

# Telegram (upcoming)
FINOPS_TELEGRAM_BOT_TOKEN=
FINOPS_TELEGRAM_CHAT_ID=

# Azure (upcoming)
FINOPS_AZURE_SUBSCRIPTION_ID=

# Agent Config
FINOPS_APPROVAL_REQUIRED=true
FINOPS_MAX_AUTO_SAVINGS_THRESHOLD=100.0
FINOPS_ANOMALY_SENSITIVITY=0.95

# Observability
FINOPS_LANGSMITH_API_KEY=
FINOPS_LANGSMITH_PROJECT=agentic-finops
